# =============================================================================
# BarberSystem — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env — ele está no .gitignore.
# =============================================================================

# ── Aplicação ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (valores fictícios para desenvolvimento local) ─────────────────
POSTGRES_USER=barbersystem
POSTGRES_PASSWORD=barbersystem_dev_password
POSTGRES_DB=barbersystem
POSTGRES_PORT=5432
DATABASE_URL=postgresql://barbersystem:barbersystem_dev_password@localhost:5432/barbersystem

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL fictícia da API para o ambiente local
VITE_API_URL=http://localhost:3000
