generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  STAFF
  CLIENT

  @@map("user_type")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  userType     UserType  @map("user_type")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  staffProfile        StaffProfile?
  clientProfile       ClientProfile?
  ownedBusinesses     Business[]           @relation("BusinessOwner")
  createdAppointments Appointment[]        @relation("AppointmentCreator")
  uploadedMedia       Media[]              @relation("MediaUploader")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([userType, isActive])
  @@index([deletedAt])
  @@map("users")
}

model StaffProfile {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  bio        String?   @db.Text
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([businessId, isActive])
  @@index([roleId])
  @@index([deletedAt])
  @@map("staff_profiles")
}

model ClientProfile {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  birthDate DateTime? @map("birth_date") @db.Date
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([deletedAt])
  @@map("client_profiles")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String?   @map("business_id") @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  staffProfiles   StaffProfile[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Business {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @unique @db.VarChar(100)
  taxId     String?   @unique @map("tax_id") @db.VarChar(30)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(30)
  address   Json?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner         User              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  settings      BusinessSettings?
  businessHours BusinessHours[]
  roles         Role[]
  staffProfiles StaffProfile[]
  media         Media[]
  services      Service[]
  appointments  Appointment[]
  auditLogs     AuditLog[]

  @@index([ownerId])
  @@index([isActive, deletedAt])
  @@map("business")
}

model BusinessSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  businessId                  String   @unique @map("business_id") @db.Uuid
  timezone                    String   @default("America/Sao_Paulo") @db.VarChar(100)
  slotIntervalMinutes         Int      @default(15) @map("slot_interval_minutes") @db.SmallInt
  minimumAdvanceMinutes       Int      @default(0) @map("minimum_advance_minutes")
  maximumAdvanceDays          Int      @default(60) @map("maximum_advance_days") @db.SmallInt
  cancellationDeadlineMinutes Int      @default(0) @map("cancellation_deadline_minutes")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model BusinessHours {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  dayOfWeek  Int       @map("day_of_week") @db.SmallInt
  opensAt    DateTime? @map("opens_at") @db.Time(0)
  closesAt   DateTime? @map("closes_at") @db.Time(0)
  isClosed   Boolean   @default(false) @map("is_closed")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model Media {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  uploadedById String    @map("uploaded_by") @db.Uuid
  url          String    @db.Text
  storagePath  String    @map("storage_path") @db.Text
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt    @map("size_bytes")
  width        Int?
  height       Int?
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("media")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  name            String    @db.VarChar(120)
  description     String?   @db.Text
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  price           Decimal   @db.Decimal(10, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointmentServices AppointmentService[]

  @@index([businessId, isActive])
  @@index([deletedAt])
  @@map("services")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @map("business_id") @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  staffProfileId     String            @map("staff_profile_id") @db.Uuid
  createdById        String            @map("created_by") @db.Uuid
  status             AppointmentStatus @default(SCHEDULED)
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  notes              String?           @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  client       ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile         @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  services     AppointmentService[]

  @@index([businessId, startsAt])
  @@index([staffProfileId, startsAt, endsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
  @@index([createdById])
  @@map("appointments")
}

model AppointmentService {
  id                String   @id @default(uuid()) @db.Uuid
  appointmentId     String   @map("appointment_id") @db.Uuid
  serviceId         String   @map("service_id") @db.Uuid
  serviceNameAtTime String   @map("service_name_at_time") @db.VarChar(120)
  durationAtTime    Int      @map("duration_at_time") @db.SmallInt
  priceAtTime       Decimal  @map("price_at_time") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  businessId String?  @map("business_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
